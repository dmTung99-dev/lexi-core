# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase config (contains secrets)
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
ios/GoogleService-Info.plist

# Flutter DevTools local config
devtools_options.yaml

# Firebase CLI local deploy cache
.firebase/

# Firebase Admin SDK service account keys (never commit)
*firebase-adminsdk*.json
docs/lexi-core-firebase-adminsdk-fbsvc-a2d70465e6.json
scripts/import-vocab/*.json
!scripts/import-vocab/package.json
**/node_modules/

# Next.js (apps/web)
apps/web/.next/

# TypeScript incremental build cache (apps/web, functions)
*.tsbuildinfo

# Local env files (apps/web) — Firebase web config is not secret, but keep the
# convention of not committing .env*.local anyway.
apps/web/.env*.local

# Firebase/Claude Agent Skills (auto-installed/updated by `firebase init`'s
# "Agent Skills Setup" prompt) — tool-level reference docs, not app source;
# churns on every firebase init/CLI update, not worth tracking.
.agents/skills/
.claude/skills/
skills-lock.json

# superpowers:brainstorming visual-companion mockups — throwaway HTML/CSS/JS
# prototypes used to validate UX during design sessions, not app source.
.superpowers/brainstorm/

# CodeGraph local index (per-machine; rebuild with `codegraph init`)
.codegraph/
apps/web/audit-out/
